# Copy this file to ".env" and fill in your own values.
# Vite only exposes variables prefixed with VITE_ to the browser.
#
# These are ONLY needed when you switch the data layer from the built-in
# mock store to a real Supabase backend (see src/lib/store.js and the README).
#
# The anon/publishable key is safe to expose to the browser, but it still
# belongs in an env file (which is git-ignored) rather than hard-coded in source.

VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-publishable-anon-key
